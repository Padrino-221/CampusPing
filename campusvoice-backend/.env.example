# App
APP_NAME=CampusVoice
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ENVIRONMENT=development

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_DB_PASSWORD@localhost:5432/campusvoice
SYNC_DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/campusvoice

# Redis
REDIS_URL=redis://localhost:6379/0

# Arkesel (SMS API)
ARKESEL_API_KEY=YOUR_ARKESEL_API_KEY
ARKESEL_SENDER_ID=CampusVoice

# Paystack — use TEST keys for development (sk_test_... / pk_test_...)
PAYSTACK_SECRET_KEY=sk_test_YOUR_PAYSTACK_SECRET_KEY
PAYSTACK_PUBLIC_KEY=pk_test_YOUR_PAYSTACK_PUBLIC_KEY

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Default Admin Credentials — CHANGE THESE in production
ADMIN_EMAIL=admin@campusvoice.com
ADMIN_PASSWORD=CHANGE_ME_use_a_strong_password
